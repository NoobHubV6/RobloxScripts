local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("67 Simulator")
local Main = Window:NewSection("Main")
local fastAura, Streak = nil, 1
Main:CreateButton("Reset Streak", function()
  Streak = 1
end)
Main:CreateToggle("Fast Aura", function(state)
  fastAura = state
end)
spawn(function()
  task0 = function()
    if fastAura then
      Streak = Streak + 1
      game.ReplicatedStorage.Remotes.AuraGained:FireServer({streak = Streak, targetSide = "right", hitType = "sweet"})
    end
  end
  while task.wait() do
    pcall(task0)
  end
end)
