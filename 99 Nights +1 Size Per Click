local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("99 Nights +1 Size Per Click")
local Main = Window:NewSection("Main")
local autoClick, autoWin
Main:CreateToggle("Auto Click", function(state)
  autoClick = state
end)
Main:CreateToggle("Auto Win", function(state)
  autoWin = state
end)
spawn(function()
  task0 = function()
    if autoWin then
      if workspace.WinPads["9676"].Transparency == 0 then
        workspace.WinPads["9676"].Transparency = 1
      end
      workspace.WinPads["9676"].CFrame = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
    end
    if autoClick then
      game.ReplicatedStorage.RemoteEvents.Click:FireServer()
    end
  end
  while task.wait() do
    pcall(task0)
  end
end)
