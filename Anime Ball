     function task1()
         local humanoid = Player.Character.Humanoid
         if GetBall() and humanoid and AutoMove then
                humanoid:MoveTo(GetBall().Position)
         end
         if visual then
                visual.Color = Color3.fromHSV(tick() % (10/1) / (10/1), 1, 1)
