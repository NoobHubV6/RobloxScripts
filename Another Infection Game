local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("Another Infection Game")
local Main = Window:NewSection("Main")
local fastAttack
Main:CreateToggle("Fast Attack", function(state)
  fastAttack = state
end)
game:GetService("RunService").RenderStepped:Connect(function()
  if fastAttack then
    for i,v in ipairs(game.Players:GetPlayers()) do
      if v ~= game.Players.LocalPlayer and v.Team ~= game.Players.LocalPlayer.Team then
        if (v.Character.HumanoidRootPart.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).Magnitude <= 9 and game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool") then
          game.ReplicatedStorage.Functions.OnWeaponHit:InvokeServer(v.Character:FindFirstChild("Humanoid"), game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool"))
        end
      end
    end
  end
end)
