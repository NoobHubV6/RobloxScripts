local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local autoStrength21, Connection
local Window = lib:NewWindow("Blades World")
local Strength, Main = Window:NewSection("Strength"), Window:NewSection("Main")
Strength:CreateToggle("swing swords 21 per", function(state)
  autoStrength21 = state
end)
Strength:CreateToggle("swing swords 6 per", function(state)
  workspace.Inventory.RemoteEvent:FireServer("1")
  wait(.1)
  game.TextChatService.TextChannels.RBXGeneral:SendAsync("/swords")
  wait(.1)
  autoStrength6 = state
end)
Main:CreateToggle("Auto Orbs", function(state)
  if state then
      Connection = game.workspace.activeOrbs.ChildAdded:Connect(function(child)
          child.CFrame = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
      end)
      for i,v in ipairs(game.workspace.activeOrbs:GetChildren()) do
          if v:IsA("Part") then
              firetouchinterest(v, game.Players.LocalPlayer.Character.HumanoidRootPart, 0)
          end
      end
  else
      Connection:Disconnect()
      Connection = nil
  end
end)

Main:CreateButton("Hide", function()
  game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(574, 4, -494)
end)
Main:CreateButton("Complete Quest 1", function()
  for i,v in next, game.Workspace.RoseHuntMission:GetChildren() do
    if v:FindFirstChild("ProximityPrompt") then
      game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame
      wait(.15)
      fireproximityprompt(v:FindFirstChild("ProximityPrompt"), 2, false)
    end
  end
end)
Main:CreateButton("Complete Quest 3", function()
  local pos = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
  game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(0, 0, 1e7)
  task.wait(.5)
  game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = pos
end)
game:GetService("RunService").RenderStepped:Connect(function()
  if autoStrength21 then
    workspace.BladePowerGiver.RemoteEvent:FireServer()
  end
  if autoStrength6 then
    game.Players.LocalPlayer.Character:FindFirstChild("1"):Activate()
  end
end)
spawn(function()
  while task.wait() do
    pcall(function()
      if autoStrength6 then
        for i,v in ipairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
          if v:IsA("Tool") and v.Name == "1" then
            game.Players.LocalPlayer.Character.Humanoid:EquipTool(v); task.wait(.0375)
          end
        end
      end
    end)
  end
end)
