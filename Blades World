local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local remote, Connection, click, stop
local fastClick, number = nil, 0.2
local Window = lib:NewWindow("Blades World")
local Strength, Main = Window:NewSection("Strength"), Window:NewSection("Main")
function Dupe(amount)
  stop = true
  for i = 1,amount or 1 do
    if game.Players.LocalPlayer.Character:FindFirstChild("1") or game.Players.LocalPlayer.Backpack:FindFirstChild("1") then
      --nothing
    else
      workspace.Inventory.RemoteEvent:FireServer("1")
    end
    game.Players.LocalPlayer.Character.Humanoid:UnequipTools()
    wait(.1875)
    for i,v in ipairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
      if v:IsA("Tool") then
        v.Parent = game.Players.LocalPlayer.Character
      end
    end
    wait(.1875)
    for i,v in ipairs(game.Players.LocalPlayer.Character:GetChildren()) do
      if v:IsA("Tool") then
        v.Parent = game.Workspace
      end
    end
    wait(.1875)
    workspace.Inventory.RemoteEvent:FireServer("1")
    wait(.1875)
    for i,v in ipairs(workspace:GetChildren()) do
      if v:IsA("Tool") then
        game.Players.LocalPlayer.Character.Humanoid:EquipTool(v)
      end
    end
   wait(.875)
  end
  stop = false
end
Strength:CreateDropdown("Select fast or normal", {"normal","fast"}, 1, function(select)
  if select == "normal" then
    number = 0.2
  elseif select == "fast" then
    number = 0.0375
  end
end)
Strength:CreateToggle("Auto Strength (remote)", function(state)
  remote = state
end)
Strength:CreateToggle("Auto Strength (click)", function(state)
  click = state
  if click then
    if #game.Players.LocalPlayer.Backpack:GetChildren() <= 2 then
      Dupe(15)
    end
  end
end)
Main:CreateToggle("Auto Orbs", function(state)
  if state then
      Connection = game.workspace.activeOrbs.ChildAdded:Connect(function(child)
          child.CFrame = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
      end)
      for i,v in ipairs(game.workspace.activeOrbs:GetChildren()) do
          if v:IsA("Part") then
              firetouchinterest(v, game.Players.LocalPlayer.Character.HumanoidRootPart, 0)
          end
      end
  else
      Connection:Disconnect()
      Connection = nil
  end
end)

Main:CreateButton("Hide", function()
  game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(574, 4, -494)
end)
Main:CreateButton("Complete Quest 1", function()
  for i,v in next, game.Workspace.RoseHuntMission:GetChildren() do
    if v:FindFirstChild("ProximityPrompt") then
      game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame
      wait(.15)
      fireproximityprompt(v:FindFirstChild("ProximityPrompt"), 2, false)
    end
  end
end)
Main:CreateButton("Complete Quest 3", function()
  local pos = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
  game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(0, 0, 1e7)
  task.wait(.5)
  game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = pos
end)
Main:CreateTextbox("Dupe Amount", function(text)
  local args = tonumber(text)
  if args then
    Dupe(args)
  end
end)
game:GetService("RunService").RenderStepped:Connect(function()
  if remote then
    workspace.BladePowerGiver.RemoteEvent:FireServer()
  end
  if click then
    game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool"):Activate()
  end
end)
game.Players.LocalPlayer.CharacterAdded:Connect(function()
  if click then
    Dupe(15)
  end
end)
spawn(function()
  while task.wait() do
    pcall(function()
      if click and not stop then
        for i,v in ipairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
          if v:IsA("Tool") and click and not stop then
            game.Players.LocalPlayer.Character.Humanoid:EquipTool(v); task.wait(number)
          end
        end
      end
    end)
  end
end)
