local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("Deathrun RNG")
local Main = Window:NewSection("Main")
local autoWin, autoRebirth
Main:CreateToggle("Auto Win", function(state)
  autoWin = state
end)
Main:CreateToggle("Auto Rebirth", function(state)
  autoRebirth = state
end)
spawn(function()
  task0 = function()
    if autoWin then
      game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(57, -42, 4362)
    end
    if autoRebirth then
      game.ReplicatedStorage.Remotes.RebirthEvent:FireServer()
    end
  end
  while task.wait() do
    pcall(task0)
  end
end)
