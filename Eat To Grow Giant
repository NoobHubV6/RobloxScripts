local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("Eat to grow giant")
local Main = Window:NewSection("Main")
local fastEat
Main:CreateToggle("Fast Train", function(state)
  fastEat = state
  if not fastEat then
    game.ReplicatedStorage.Events.AutoEatFastOff:FireServer()
  end
end)
spawn(function()
  task0 = function()
    if fastEat then
      game.ReplicatedStorage.Events.AutoEatFastOn:FireServer()
    end
  end
  while task.wait() do
    pcall(task0)
  end
end)
