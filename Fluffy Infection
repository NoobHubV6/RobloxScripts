local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("Fluffy Infection")
local Main, Team = Window:NewSection("Main"), Window:NewSection("Team")
local killAura, autoEscape, autoGetBat, spamSounds
function GetBat()
if game.Players.LocalPlayer.Team == game.Teams.Human then
        if game.Players.LocalPlayer.Character:FindFirstChild("Bat") or game.Players.LocalPlayer.Backpack:FindFirstChild("Bat") or game.Players.LocalPlayer.Backpack:FindFirstChild("Metal Bat") or game.Players.LocalPlayer.Character:FindFirstChild("Metal Bat") then
    
    else    
    local oldpos = game:GetService("Players").LocalPlayer.Character.HumanoidRootPart.CFrame
    game:GetService("Players").LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(workspace.Map.MetalBat.Position)
    repeat task.wait()
    game:GetService("Players").LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(workspace.Map.MetalBat.Position)
    fireproximityprompt(workspace.Map.MetalBat.ProximityPrompt, 2, false)
    until game.Players.LocalPlayer.Character:FindFirstChild("Bat") or game.Players.LocalPlayer.Backpack:FindFirstChild("Bat") or game.Players.LocalPlayer.Backpack:FindFirstChild("Metal Bat") or game.Players.LocalPlayer.Character:FindFirstChild("Metal Bat")
    game:GetService("Players").localPlayer.Character.HumanoidRootPart.CFrame = oldpos
end
end
end
Main:CreateToggle("Kill Aura", function(state)
  killAura = state
end)
Main:CreateToggle("Auto Get Bat", function(state)
  autoGetBat = state
end)
Main:CreateButton("Kill All", function()
  local savedpos = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
GetBat()
for i,v in next, game.Teams.Krymzonix:GetPlayers() do
if v ~= game.Players.LocalPlayer and not v.Character:FindFirstChildWhichIsA("ForceField") and v.Character.Humanoid.Health ~= 0 then
if not v:IsFriendsWith(game.Players.LocalPlayer.UserId) then
repeat task.wait()
      if game.Players.LocalPlayer.Backpack:FindFirstChild("Metal Bat") then
            game.Players.LocalPlayer.Character.Humanoid:EquipTool(game.Players.LocalPlayer.Backpack:FindFirstChild("Metal Bat"))
      end
      game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.Character.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
      game.Players.LocalPlayer.Character:FindFirstChild("Metal Bat").Remote.Hit:FireServer(v.Character.Torso,v.Character.Humanoid,v.Character.Torso.Position)
until v.Team == game.Teams.Human or v.Character.Humanoid.Health == 0
end
end
end
wait(.1)
game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = savedpos
wait(.05)
savedpos = nil
end)
Main:CreateToggle("Auto Escape Gui", function(state)
  autoEscape = state
end)
Main:CreateToggle("Spam Tool Sounds", function(state)
  spamSounds = state
end)
Team:CreateButton("Human", function()
  if game.Players.LocalPlayer.Team == game.Teams.Krymzonix then
    local pos = game.Players.localPlayer.Character.HumanoidRootPart.CFrame
    game.Players.LocalPlayer.Character.Humanoid.Health = 0
    game.Players.localPlayer.CharacterAdded:Wait().HumanoidRootPart.CFrame = pos
  end
end)
Team:CreateButton("Krymzonix", function()
  if game.Players.LocalPlayer.Team == game.Teams.Human then
    firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, workspace.Map.CrimsonPart:GetChildren()[9], 0)
  end
end)
game:GetService("RunService").RenderStepped:Connect(function()
  if killAura then
    for i,v in ipairs(game.Players:GetPlayers()) do
      if v.Team ~= game.Players.LocalPlayer.Team and v.Character.Humanoid.Health ~= 0 then
        local tool = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool and (v.Character.HumanoidRootPart.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).Magnitude <= 10 then
          tool.Remote.Hit:FireServer(v.Character.HumanoidRootPart, v.Character.Humanoid, v.Character.HumanoidRootPart.Position)
        end
      end
    end
  end
  if autoEscape then
    game.Players.LocalPlayer.PlayerGui.EscapeGui.Remote.Hit:InvokeServer()
  end
  if spamSounds then
    game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool").Remote.PlaySound:FireServer('Swing')
  end
end)
spawn(function()
  while task.wait() do
    pcall(function()
      if autoGetBat then
        GetBat()
end
end)
end
end)
