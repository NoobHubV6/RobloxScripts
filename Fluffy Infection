        if v.Team ~= game.Players.LocalPlayer.Team and v.Character.Humanoid.Health ~= 0 then
          local tool = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool")
          if tool and (v.Character.HumanoidRootPart.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).Magnitude <= 10 then
            tool.Remote.Hit:FireServer(v.Character.HumanoidRootPart, v.Character.Humanoid, v.Character.HumanoidRootPart.Position)
          end
