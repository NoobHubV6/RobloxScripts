function KillAllFurry()
  for i,v in next, game.Teams.Krymzonix:GetPlayers() do
if v ~= game.Players.LocalPlayer and not v.Character:FindFirstChildWhichIsA("ForceField") and v.Character.Humanoid.Health ~= 0 then
if not v:IsFriendsWith(game.Players.LocalPlayer.UserId) then
  local savedpos = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
  repeat task.wait()
      GetBat()
      if game.Players.LocalPlayer.Backpack:FindFirstChild("Radioactive Bat") then
            game.Players.LocalPlayer.Character.Humanoid:EquipTool(game.Players.LocalPlayer.Backpack:FindFirstChild("Radioactive Bat"))
      end
      game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.Character.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
      game.Players.LocalPlayer.Character:FindFirstChild("Radioactive Bat").Remote.Hit:FireServer(v.Character.Torso,v.Character.Humanoid,v.Character.Torso.Position)
  until v.Team == game.Teams.Human or not v.Character or v.Character.Humanoid.Health == 0
  game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = savedpos
end
end
end
end
function KillAllHuman()
