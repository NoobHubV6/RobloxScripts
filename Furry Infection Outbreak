local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("Furry Infection Outbreak")
local Main = Window:NewSection("Main")
local killAura
Main:CreateToggle("Kill Aura", function(state)
  killAura = state
end)
game:GetService("RunService").RenderStepped:Connect(function()
  if killAura then
    for i,v in ipairs(game.Players:GetPlayers()) do
      if v ~= game.Players.LocalPlayer and v.Team ~= game.Players.LocalPlayer.Team then
        if (v.Character.HumanoidRootPart.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).Magnitude <= 10 and game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool") then
          game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool").ActionEvent:FireServer("CanTouch",true)
          game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool").AllActionScr.CheckedFunction:InvokeServer(v.Character.HumanoidRootPart)
        end
      end
    end
  end
end)
