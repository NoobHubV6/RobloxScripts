local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("Grab Battles")
local Main, Info = Window:NewSection("Main"), Window:NewSection("Info")
local autoGrab, antiRagdoll, autoEscape
local Player = game.Players.localPlayer
local autoThrow
Main:CreateToggle("Auto Grab", function(state)
  autoGrab = state
end)
Main:CreateToggle("Anti Ragdoll", function(state)
  antiRagdoll = state
end)
Main:CreateToggle("Auto Escape", function(state)
  autoEscape = state
end)
Main:CreateToggle("Auto Throw", function(state)
  autoThrow = state
end)
Info:CreateButton("Created by NoobHubV6", function()
  --Nothing
end)
game.Players.LocalPlayer.PlayerGui.Interface.ThrowButton:GetPropertyChangedSignal("Visible"):Connect(function()
  if autoThrow and game.Players.LocalPlayer.PlayerGui.Interface.ThrowButton.Visible then
    local pos = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(403, 160, 273)
    wait(.2)
    game.ReplicatedStorage.Packages:FindFirstChild("_Index"):FindFirstChild("sleitnick_knit@1.7.0").knit.Services.HugService.RE.ThrowPlayer:FireServer()
    repeat task.wait() until not game.Players.LocalPlayer.PlayerGui.Interface.ThrowButton.Visible
    wait(.2)
    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = pos
  end
end)
spawn(function()
  task0 = function()
    if autoGrab then
      for i,v in ipairs(game.Players:GetPlayers()) do
       if v ~= game.Players.LocalPlayer and (Player.Character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude <= 10 then
         game.ReplicatedStorage.Packages:FindFirstChild("_Index"):FindFirstChild("sleitnick_knit@1.7.0").knit.Services.HugService.RE.Hug:FireServer(v.Character)
       end
      end
    end
    if antiRagdoll then
      game.ReplicatedStorage.Packages:FindFirstChild("_Index"):FindFirstChild("sleitnick_knit@1.7.0").knit.Services.RagdollService.RE.SetRagdoll:FireServer(false)
    end
    if autoEscape then
      game.ReplicatedStorage.Packages:FindFirstChild("_Index"):FindFirstChild("sleitnick_knit@1.7.0").knit.Services.HugService.RE.Escape:FireServer()
    end
  end
  while task.wait() do
    pcall(task0)
  end
end)
