local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("Grow Every Step")
local Main = Window:NewSection("Main")
local autoSize
Main:CreateToggle("Auto Size", function(state)
  autoSize = state
end)
spawn(function()
  task0 = function()
    if autoSize then
      for i = 1,2 do
        game.ReplicatedStorage.Remotes.IncreaseSize:FireServer()
      end
    end
  end
  while task.wait() do
    pcall(task0)
  end
end)
