local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("Infinite parts")
local Main, Rebirth = Window:NewSection("Main"), Window:NewSection("Rebirth")
local collectParts, autoBuyArea
local autoRebirth, autoUpgrades
local rebirthArea, ScreenGui = 130, Instance.new("ScreenGui", game.CoreGui)
local TextLabel = Instance.new("TextButton", ScreenGui)
Main:CreateToggle("Collect Parts", function(state)
  collectParts = state
end)
Main:CreateToggle("Auto Buy Area", function(state)
  autoBuyArea = state
  if autoBuyArea then
    for i,v in ipairs(workspace.Map.Areas:GetChildren()) do
      game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.Primary.CFrame
    end
  end
end)
Main:CreateToggle("Auto Upgrades", function(state)
  autoUpgrades = state
end)
Main:CreateToggle("Show Stats", function(state)
  TextLabel.Visible = state
end)
Rebirth:CreateTextbox("Rebirth Area", function(value)
  rebirthArea = tonumber(value)
end)
Rebirth:CreateToggle("Auto Rebirth", function(state)
  autoRebirth = state
end)
workspace.Map.Areas.ChildAdded:Connect(function(child)
  if autoBuyArea then
    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = child.Primary.CFrame
  end
end)

ScreenGui.Name = "gui"
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.ResetOnSpawn = true

TextLabel.BackgroundColor3 = Color3.fromRGB(50, 100, 150)
TextLabel.BackgroundTransparency = 1
TextLabel.Position = UDim2.new(0, 0, 0, 0)
TextLabel.Size = UDim2.new(0, 180, 0, 40)
TextLabel.Font = Enum.Font.SourceSans
TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TextLabel.TextScaled = true
TextLabel.TextSize = 15.000
TextLabel.TextStrokeTransparency = 0.000
TextLabel.TextWrapped = true
TextLabel.Draggable = false
TextLabel.Visible = false
while task.wait() do
  TextLabel.Text = "Ping: "..game.Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
end
spawn(function()
  task0 = function()
    if collectParts then
      for i,v in ipairs(workspace.PartFolder:GetChildren()) do
         v.CFrame = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
      end
    end
    if autoBuyArea then
      game.ReplicatedStorage.Objects.Remotes.Area.BuyArea:FireServer()
    end
    if autoUpgrades then
      game.ReplicatedStorage.Objects.Remotes.Upgrades.BuyUpgrade:FireServer("PartValue")
      game.ReplicatedStorage.Objects.Remotes.Upgrades.BuyUpgrade:FireServer("PartSpawnRate")
    end
    if autoRebirth then
      area = rebirthArea
      for i,v in ipairs(workspace.Map.Areas:GetChildren()) do
        if v.Primary:GetAttribute("AreaIndex") >= area then
          game.ReplicatedStorage.Objects.Remotes.Prestige.DoPrestige:FireServer("Rebirth")
        end
      end
    end
  end
  while task.wait() do
    pcall(task0)
  end
end)
