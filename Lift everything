local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("Lift Everything")
local Main = Window:NewSection("Main")
local fastTrain
Main:CreateToggle("Fast Train", function(state)
  if state then
    fastTrain = game.RunService.RenderStepped:Connect(function()
      game.ReplicatedStorage.BLINK_RELIABLE_REMOTE:FireServer(buffer.fromstring("\v"), {})
    end)
  elseif not state then
    fastTrain:Disconnect()
    fastTrain = nil
  end
end)
