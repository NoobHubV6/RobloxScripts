local Main = Window:NewSection("Main")
local autoWin, stage = nil, 1
Main:CreateDropdown("Map", {"1","2","3","4"}, 1, function(value)
  stage = value
end)
Main:CreateToggle("Auto Win", function(state)
  autoWin = state
end)
spawn(function()
  task0 = function()
    if autoWin then
      game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = workspace:FindFirstChild("Stage"..stage).WinPromptPart.CFrame
      wait(.2)
      fireproximityprompt(workspace:FindFirstChild("Stage"..stage).WinPromptPart:FindFirstChild("ProximityPrompt"))
      wait(.175)
      game.ReplicatedStorage.RebirthRequest:InvokeServer()
      wait(.4625)
    end
  end
  while task.wait() do
    pcall(task0)
  end
end)
