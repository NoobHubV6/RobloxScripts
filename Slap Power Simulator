local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("Slap Power Simulator")
local Main = Window:NewSection("Main")
local x10Power
local autoWin
Main:CreateToggle("x10 Power/second", function(state)
  x10Power = state
end)
Main:CreateButton("Reset Power", function()
  game.ReplicatedStorage.Remotes.Client:InvokeServer("ClickStat", -game:GetService("Players").LocalPlayer.leaderstats.Power.Value)
end)
Main:CreateToggle("Auto Win", function(state)
  autoWin = state
end)
spawn(function()
  task0 = function()
    if x10Power then
      local PowerValue = game:GetService("Players").LocalPlayer.leaderstats.Power.Value * 9
      game.ReplicatedStorage.Remotes.Client:InvokeServer("ClickStat", PowerValue)
      if game:GetService("Players").LocalPlayer.leaderstats.Power.Value == 0 or game:GetService("Players").LocalPlayer.leaderstats.Power.Value <= 0 then
        game.ReplicatedStorage.Remotes.Client:InvokeServer("ClickStat", 10)
      end
      wait(1)
    end
    if autoWin then
      game.ReplicatedStorage.Remotes.Client:InvokeServer("Wins")
    end
  end
  while task.wait() do
    pcall(task0)
  end
end)
spawn(function()
  task1 = function()
    if autoWin then
      game.ReplicatedStorage.Remotes.Client:InvokeServer("Wins")
    end
  end
  while task.wait() do
    pcall(task1)
  end
end)
