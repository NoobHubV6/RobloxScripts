local lib = loadstring(Game:HttpGet("https://raw.githubusercontent.com/NoobHubV1/NoobHubV1/main/Wizard%20Lib.lua"))()
local Window = lib:NewWindow("YoYo Simulator")
local Main = Window:NewSection("Main")
local fastClick, autoSell
Main:CreateToggle("Fast Click", function(state)
  fastClick = state
end)
Main:CreateToggle("Auto Sell", function(state)
  autoSell = state
end)
spawn(function()
  task0 = function()
    if fastClick then
      game.ReplicatedStorage.Events.ToolEvents.ClickTool:FireServer(game.Players.LocalPlayer)
    end
    if autoSell then
      game.ReplicatedStorage.Events.Sell:InvokeServer(game.Players.LocalPlayer)
    end
  end
  while task.wait() do
    pcall(task0)
  end
end)
